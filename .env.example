# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional)
API_KEY=sua-chave-secreta-aqui

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Web search tool (SearXNG)
SEARXNG_SEARCH_URL=http://searxng:8080/search
SEARXNG_TIMEOUT_MS=15000

# Rede interna do Coolify
# Na maioria das instalacoes o nome e "coolify".
COOLIFY_NETWORK=coolify
